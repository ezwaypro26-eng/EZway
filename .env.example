# Server only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
OWNER_USER_IDS=YOUR_SUPABASE_AUTH_USER_UUID
MEDIA_BUCKET=ezway-media
# Optional: database CA certificate PEM if your connection requires a private CA.
DATABASE_CA_CERT=
# Public browser configuration (these values are compiled during npm run build)
VITE_EZWAY_API_URL=/api/data
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Optional integrations; do not use VITE_ for provider secret keys.
GEMINI_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_ALBUM_COVER_API_URL=
VITE_AUDIO_TOOLS_URL=
VITE_MUSIC_INTELLIGENCE_API_URL=
